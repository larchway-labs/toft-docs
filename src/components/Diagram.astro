---
/**
 * A diagram, inlined from src/diagrams/<name>.svg so its classes take the
 * page's tokens (toft.css § Diagrams) and it turns over with the theme. An
 * <img> could not: a stylesheet does not reach inside one.
 *
 * Write the tag on one line — <Diagram name="x" alt="…" caption="…" /> — with
 * no double quotes inside the values: the Markdown copy (src/lib/markdown.ts)
 * replaces that line with the alt text, which is the diagram for an agent.
 */
interface Props {
  name: string;
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;
const files = import.meta.glob<string>("../diagrams/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const svg = files[`../diagrams/${name}.svg`];
if (!svg) throw new Error(`No diagram src/diagrams/${name}.svg`);
---

<figure class="toft-diagram not-content">
  <div class="toft-diagram-art" role="img" aria-label={alt} set:html={svg} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
