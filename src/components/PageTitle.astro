---
/**
 * A page's head: where it sits, its title, its one-line description as the
 * lede, and the two ways to hand the page to an agent.
 *
 * The description was frontmatter nobody saw but a search engine. Every page
 * has one, and it is the sentence that tells a reader whether this is the
 * page they wanted, so it is set under the title in the landing page's muted
 * second voice.
 */
import { guides } from "../sidebar.mjs";
import { markdownHref } from "../lib/markdown";

// Starlight links "Overview" in the contents rail to this id.
const PAGE_TITLE_ID = "_top";

const { id, entry, sidebar } = Astro.locals.starlightRoute;
const guide = guides.find((g) => g.id === id.split("/")[0]);
const section = sidebar.find(
  (e) => e.type === "group" && e.entries.some((l) => l.type === "link" && l.isCurrent),
)?.label;
const md = markdownHref(id);
---

<div class="toft-page-head">
  {
    guide && (
      <p class="toft-eyebrow">
        {guide.label}
        {section && <span aria-hidden="true">/</span>}
        {section}
      </p>
    )
  }
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  {entry.data.description && <p class="toft-lede">{entry.data.description}</p>}
  <div class="toft-page-actions print:hidden">
    <button type="button" class="toft-copy-page" data-src={md}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <span>Copy as Markdown</span>
    </button>
    <a href={md}>View as Markdown</a>
  </div>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".toft-copy-page")) {
    const label = button.querySelector("span")!;
    button.addEventListener("click", async () => {
      try {
        const text = await (await fetch(button.dataset.src!)).text();
        await navigator.clipboard.writeText(text);
        label.textContent = "Copied";
      } catch {
        label.textContent = "Couldn’t copy";
      }
      setTimeout(() => (label.textContent = "Copy as Markdown"), 2000);
    });
  }
</script>
