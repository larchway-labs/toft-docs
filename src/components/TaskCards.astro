---
/**
 * The home page's "start with a task" grid: six things people come to do, each
 * a card naming its guide. The guide map below is the full index; this is the
 * short way in, so it stays hand-picked and short. Every link must be a page
 * in src/sidebar.mjs — the build fails if one is not.
 */
import { readingOrder } from "../sidebar.mjs";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const pages = new Map(readingOrder().map((p) => [p.slug, p]));

// Icon paths are drawn on a 24-unit grid with a 2-unit stroke.
const icons = {
  repo: '<circle cx="6" cy="18" r="3"/><circle cx="18" cy="6" r="3"/><path d="M6 3v12"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  terminal: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
  people: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  server: '<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01"/><path d="M6 18h.01"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
};

const tasks = [
  { icon: "repo", title: "Deploy from a repository", body: "Paste a URL. Toft clones, builds, runs and serves it.", slug: "user/deploy/from-git" },
  { icon: "terminal", title: "Deploy from your machine", body: "Push your working tree with toft deploy, no git push needed.", slug: "user/deploy/from-your-machine" },
  { icon: "people", title: "Share an app", body: "Restricted, everyone signed in, or public, and who may ask.", slug: "user/share/visibility" },
  { icon: "clock", title: "Schedule work", body: "Run your code on a schedule or on demand, as jobs.", slug: "user/automation/jobs" },
  { icon: "server", title: "Install Toft", body: "One box with Docker Compose, or a cluster with the Helm chart.", slug: "admin/start/install-options" },
  { icon: "code", title: "Use the app SDK", body: "Data, files, jobs and notifications from Python, Node, R and Go.", slug: "cli/sdk/what-it-is" },
];

for (const t of tasks) {
  if (!pages.has(t.slug)) throw new Error(`TaskCards: ${t.slug} is not in the sidebar`);
}
---

<section class="not-content toft-tasks" aria-labelledby="start-with-a-task">
  <h2 id="start-with-a-task" class="toft-tasks-title">Start with a task</h2>
  <ul class="toft-task-grid">
    {
      tasks.map((t) => (
        <li>
          <a class="toft-task" href={`${base}/${t.slug}/`}>
            <span class="toft-task-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[t.icon as keyof typeof icons]} />
            </span>
            <span class="toft-task-title">{t.title}</span>
            <span class="toft-task-body">{t.body}</span>
            <span class="toft-task-guide">{pages.get(t.slug)!.guide.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <h2 class="toft-tasks-title toft-index-title">Every page</h2>
</section>
